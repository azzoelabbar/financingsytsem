 "sod_rules": [
  {
   "id": "SoD-1",
   "rule": "actor != created_by for approve/post",
   "enforce": "runtime"
  },
  {
   "id": "SoD-2",
   "rule": "separate create/approve/post/execute",
   "enforce": "assignment+runtime"
  },
  {
   "id": "SoD-3",
   "rule": "supplier-bank manager != payment approver/executor",
   "enforce": "runtime"
  },
  {
   "id": "SoD-4",
   "rule": "bank poster != bank reconciliation locker",
   "enforce": "assignment(optional)"
  },
  {
   "id": "SoD-5",
   "rule": "period reopen requires higher role + reason + audit",
   "enforce": "runtime"
  },
  {
   "id": "SoD-6",
   "rule": "auditor is read-only-exclusive (no write perms)",
   "enforce": "assignment"
  },
  {
   "id": "SoD-7",
   "rule": "security admin holds no operational accounting perms",
   "enforce": "assignment"
  },
  {
   "id": "SoD-8",
   "rule": "customer/supplier creator != approver of its invoices",
   "enforce": "runtime(optional)"
  }
 ],
