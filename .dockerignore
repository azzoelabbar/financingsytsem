# Anything the image builds for itself, or must never be baked in.
.git
.gitignore
.github

# Rebuilt inside the image
node_modules
vendor
public/build
public/hot
public/storage
bootstrap/cache/*.php

# Secrets and local state — never copy these into an image
.env
.env.*
!.env.example
auth.json
storage/*.key
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/pail
*.sqlite
*.sqlite-journal
database/*.sqlite

# Dev-only tooling and editors
.claude
.agents
.cursor
.idea
.vscode
.zed
.fleet
.nova
.phpunit.cache
.phpunit.result.cache
.phpactor.json
tests
docs
resources/js-inertia-legacy
